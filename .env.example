# n8n Configuration
# Copy this file to .env and fill in your values

# n8n Instance URL (without trailing slash)
N8N_BASE_URL=http://localhost:5678

# n8n API Key (generate from n8n Settings > API)
N8N_API_KEY=your-api-key-here

# Default webhook paths (comma-separated list of webhook URLs or paths)
# These can be full URLs or just the webhook path
N8N_WEBHOOK_URLS=webhook/my-workflow,webhook/another-workflow

# Optional: Webhook authentication (if your webhooks require auth)
WEBHOOK_AUTH_HEADER=
WEBHOOK_AUTH_VALUE=
