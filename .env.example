# --- Server ---
PORT=3100
NODE_ENV=development

# --- AI Engine ---
# Anthropic Claude API (primary reasoning engine)
ANTHROPIC_API_KEY=sk-ant-xxxxx
AI_MODEL=claude-sonnet-4-20250514

# --- n8n Integration ---
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_URLS=
WEBHOOK_AUTH_HEADER=
WEBHOOK_AUTH_VALUE=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3100/auth/google/callback

# --- Google API Scopes (configured automatically) ---
# Gmail, Calendar, Drive, Docs, Sheets, Chat, Tasks

# --- Asana ---
ASANA_ACCESS_TOKEN=your_asana_personal_access_token
ASANA_WORKSPACE_ID=your_workspace_id

# --- Canva ---
CANVA_API_KEY=your_canva_api_key

# --- Security ---
# Encryption key for sensitive local data (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=generate_a_64_char_hex_string

# --- Portal ---
PORTAL_URL=http://localhost:5173

# --- A'Y Identity (for context) ---
OWNER_NAME=Ayham
