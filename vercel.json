{
  "version": 2,
  "framework": null,
  "installCommand": "npm install && cd portal && npm install",
  "buildCommand": "cd portal && npm run build",
  "outputDirectory": "portal/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "runtime": "nodejs20.x"
    }
  }
}
