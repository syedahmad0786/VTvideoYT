{
  "version": 2,
  "framework": null,
  "installCommand": "cd portal && npm install",
  "buildCommand": "cd portal && npm run build",
  "outputDirectory": "portal/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10,
      "runtime": "nodejs20.x"
    }
  }
}
