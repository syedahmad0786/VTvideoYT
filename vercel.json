{
  "version": 2,
  "framework": null,
  "installCommand": "npm install && cd portal && npm install",
  "buildCommand": "cd portal && npm run build",
  "outputDirectory": "portal/dist",
  "rewrites": [
    { "source": "/api/email/send", "destination": "/api/email/send" },
    { "source": "/api/email/webhook", "destination": "/api/email/webhook" },
    { "source": "/api/cron/check-responses", "destination": "/api/cron/check-responses" },
    { "source": "/api/sheets", "destination": "/api/sheets" },
    { "source": "/api/pipeline", "destination": "/api/pipeline" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.mjs": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/check-responses",
      "schedule": "0 8 * * *"
    }
  ]
}
